# Merge these settings into the Laravel hosting environment; do not replace
# existing APP_KEY, database credentials, or other secrets.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://donasi.example.com

# Comma-separated browser website origins, without trailing slashes.
# Native Android/iOS apps do not require a CORS origin.
CORS_ALLOWED_ORIGINS=https://donasi.example.com,https://app.example.com
SESSION_SECURE_COOKIE=true

# Keep the existing APP_KEY unchanged: signed links depend on it.
